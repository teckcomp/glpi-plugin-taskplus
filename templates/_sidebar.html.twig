{# Task+ — CASCA comum às 9 telas (16q: redesign).
   Emite TRÊS irmãos diretos de .taskplus-app (grade: 64px + 1fr):
     <header .taskplus-top>  faixa petróleo — marca · atalhos (nº 74) · sino · tema · config
     <aside  .taskplus-left> lateral estreita — navegação por ícone + rótulo
     <div    .taskplus-ctx>  título da tela + "?" com a dica (antes era um banner por tela)
   O .taskplus-main de cada template cai sozinho na célula restante.
   Espera `plugin_web_dir`, `nav` (Access::sidebar(): chaves das telas +
   `theme` + `quick_links`) e `active`. NÃO recebe csrf_token: o sino e o
   tema buscam o primeiro token nos próprios endpoints (alerts/prefs). #}

{# Tema antes do primeiro paint: o servidor manda '' (escuro, padrão) ou 'light'. #}
<script>document.documentElement.setAttribute('data-taskplus-theme', {{ nav.theme == 'light' ? "'light'" : "'dark'" }});</script>

{% set screens = {
    'today':     { 'icon': 'ti-checkbox',        'label': __('Hoje', 'taskplus'),             'hint': __('Suas tarefas do dia, em um único lugar', 'taskplus') },
    'board':     { 'icon': 'ti-layout-kanban',   'label': __('Quadro', 'taskplus'),           'hint': __('Arraste os cards entre as colunas. Soltar numa fase pede o novo prazo; em "Concluídas" conclui; em "Pendentes" pede motivo, data e hora. Tarefa atrasada fica na fase onde está, marcada em vermelho com o tempo de atraso.', 'taskplus') },
    'teamboard': { 'icon': 'ti-users-group',     'label': __('Quadro de Equipe', 'taskplus'), 'hint': __('Tarefas da equipe do setor, com um ou mais colaboradores por tarefa. Arraste entre as fases — todo movimento pede um comentário (e, nas fases, o novo prazo); tarefa atrasada fica onde está, marcada em vermelho. Clique no card para ver ou editar.', 'taskplus') },
    'routines':  { 'icon': 'ti-repeat',          'label': __('Rotinas', 'taskplus'),          'hint': __('Recorrências que viram tarefa na sua Hoje sozinhas. Rotina criada para a equipe aparece em "Criadas para a equipe".', 'taskplus') },
    'week':      { 'icon': 'ti-calendar-week',   'label': __('Semana', 'taskplus'),           'hint': __('A grade mostra suas tarefas próprias (rotinas e avulsas) e as de equipe, no dia do PRAZO, com a barra de prazo. As origens do GLPI — tickets e projetos — não têm dado por dia e seguem na tela Hoje.', 'taskplus') },
    'team':      { 'icon': 'ti-users',           'label': __('Equipe', 'taskplus'),           'hint': __('O dia de cada técnico dos setores que você administra — os mesmos números que ele vê na tela Hoje. Clique no técnico para abrir as tarefas.', 'taskplus') },
    'panel':     { 'icon': 'ti-chart-bar',       'label': __('Painel', 'taskplus'),           'hint': __('O Painel mede as tarefas próprias do plugin (rotinas e avulsas). As origens do GLPI — tickets e projetos — não têm dado por dia e ficam de fora. Tarefa pendente sai da régua: tem volta marcada.', 'taskplus') },
    'history':   { 'icon': 'ti-history',         'label': __('Histórico', 'taskplus'),        'hint': __('O Histórico mostra a trilha das tarefas próprias do plugin (rotinas e avulsas), inclusive puladas e excluídas. As origens do GLPI — tickets e projetos — não têm trilha por dia e ficam de fora.', 'taskplus') },
    'config':    { 'icon': 'ti-settings',        'label': __('Configurações', 'taskplus'),    'hint': '' }
} %}
{% set cur = screens[active] ?? screens['today'] %}

<header class="taskplus-top" id="taskplus-shell"
        data-prefs-url="{{ plugin_web_dir }}/ajax/prefs.php">
    <a class="taskplus-brand" href="{{ plugin_web_dir }}/front/today.php" title="{{ __('Tarefas', 'taskplus') }}">
        <img class="taskplus-brand__mark" alt="" src="{{ plugin_web_dir }}/img/taskplus-mark.svg">
        <span class="taskplus-brand__name">Task+</span>
        <span class="taskplus-brand__sub">{{ __('Tarefas', 'taskplus') }}</span>
    </a>

    {# 16c (nº 74): atalhos do admin — agora na faixa, em todas as telas,
       monocromáticos (a cor cadastrada fica para o cadastro). #}
    {% if nav.quick_links|length > 0 %}
    <nav class="taskplus-quicklinks" id="tp-quicklinks" aria-label="{{ __('Atalhos', 'taskplus') }}">
        {% for l in nav.quick_links %}
        <a class="taskplus-quicklinks__btn" href="{{ l.url }}"
           {% if l.new_tab %}target="_blank" rel="noopener"{% endif %} title="{{ l.url }}">
            <i class="ti {{ l.icon }}"></i><b>{{ l.name }}</b>
            {% if l.new_tab %}<i class="ti ti-external-link taskplus-quicklinks__ext"></i>{% endif %}
        </a>
        {% endfor %}
    </nav>
    {% endif %}

    <div class="taskplus-top__right">
        {# 7a: sino — mesmos ids/classes que o bell.js procura. #}
        <div class="taskplus-bell-wrap" id="taskplus-bell-wrap"
             data-alerts-url="{{ plugin_web_dir }}/ajax/alerts.php">
            <button type="button" id="taskplus-bell" class="taskplus-bell taskplus-top__btn"
                    title="{{ __('Alertas', 'taskplus') }}">
                <i class="ti ti-bell"></i><span class="taskplus-bell__badge" hidden>0</span>
            </button>
            <div id="taskplus-bell-panel" class="taskplus-bell__panel" hidden>
                <div class="taskplus-bell__head">
                    <strong>{{ __('Alertas', 'taskplus') }}</strong>
                    <button type="button" class="taskplus-bell__readall">
                        {{ __('Marcar todas como lidas', 'taskplus') }}
                    </button>
                </div>
                <ul class="taskplus-bell__list"></ul>
            </div>
        </div>
        <button type="button" id="taskplus-theme" class="taskplus-top__btn" aria-pressed="false"
                title="{{ __('Tema', 'taskplus') }}"><i class="ti ti-sun"></i></button>
        {% if nav.config %}
        <a class="taskplus-top__btn{{ active == 'config' ? ' taskplus-top__btn--on' : '' }}"
           href="{{ plugin_web_dir }}/front/config.form.php" title="{{ __('Configurações', 'taskplus') }}">
            <i class="ti ti-settings"></i></a>
        {% endif %}
    </div>
</header>

<aside class="taskplus-left">
    <nav class="taskplus-sidebar" aria-label="Task+">
        <ul>
            {% for key in ['today', 'board', 'teamboard', 'team', 'week', 'routines', 'panel', 'history'] %}
            {% if nav[key] %}
            {% set fileKey = key == 'config' ? 'config.form' : key %}
            <li class="taskplus-sidebar__item{{ active == key ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/{{ fileKey }}.php" title="{{ screens[key].label }}">
                    <i class="ti {{ screens[key].icon }}"></i><span>{{ screens[key].label }}</span></a>
            </li>
            {% endif %}
            {% endfor %}
            {# 8b-2: porta de volta para a Visão Geral nativa (só com a home trocada). #}
            {% if nav.home %}
            <li class="taskplus-sidebar__item taskplus-sidebar__item--exit">
                <a href="{{ plugin_web_dir|replace({'/plugins/taskplus': ''}) }}/front/central.php?taskplus_home=0"
                   title="{{ __('Visão Geral', 'taskplus') }}">
                    <i class="ti ti-layout-dashboard"></i><span>{{ __('Visão Geral', 'taskplus') }}</span></a>
            </li>
            {% endif %}
        </ul>
    </nav>
</aside>

<div class="taskplus-ctx">
    <h1 class="taskplus-ctx__title">{{ cur.label }}</h1>
    {% if cur.hint %}
    <span class="taskplus-ctx__help" tabindex="0" data-tip="{{ cur.hint }}" aria-label="{{ cur.hint }}">?</span>
    {% endif %}
</div>
