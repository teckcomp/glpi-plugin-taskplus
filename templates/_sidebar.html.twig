{# Task+ — sidebar comum a todas as telas do hub (extraída da Etapa 1 na
   Etapa 2a, quando "Rotinas" deixou de ser a única tela além de "Hoje").
   Espera `plugin_web_dir`, `nav` (Access::sidebar(), SEMPRE as 7 chaves)
   e `active` (chave da tela atual, para o destaque). #}
<div class="taskplus-left">
    <div class="taskplus-pagetitle">
        <div class="taskplus-brand">
            <img class="taskplus-brand__mark" alt=""
                 src="{{ plugin_web_dir }}/img/taskplus-mark.svg">
            <h2>{{ __('Task+', 'taskplus') }}</h2>
        </div>
        {# 7a: sino de alertas — mesmo padrão do ProjectPlus. Ancorado no
           CANTO SUPERIOR DIREITO do cabeçalho (posição absoluta, 7a-3:
           dentro da linha da brand ele sobrepunha o subtítulo). O JS
           (public/js/bell.js, hook global) acha o widget pelo id; fora
           das telas do plugin o markup não existe e o JS é inerte. O 1º
           token CSRF vem do próprio GET list do endpoint — por isso a
           sidebar NÃO precisa de csrf_token. #}
        <div class="taskplus-bell-wrap" id="taskplus-bell-wrap"
             data-alerts-url="{{ plugin_web_dir }}/ajax/alerts.php">
            <button type="button" id="taskplus-bell" class="taskplus-bell"
                    title="{{ __('Alertas', 'taskplus') }}">
                <i class="ti ti-bell"></i><span class="taskplus-bell__badge" hidden>0</span>
            </button>
            <div id="taskplus-bell-panel" class="taskplus-bell__panel" hidden>
                <div class="taskplus-bell__head">
                    <strong>{{ __('Alertas', 'taskplus') }}</strong>
                    <button type="button" class="taskplus-bell__readall">
                        {{ __('Marcar todas como lidas', 'taskplus') }}
                    </button>
                </div>
                <ul class="taskplus-bell__list"></ul>
            </div>
        </div>
        <span>{{ __('Suas tarefas do dia, num lugar só', 'taskplus') }}</span>
    </div>
    <nav class="taskplus-sidebar">
        <ul>
            {% if nav.today %}
            <li class="taskplus-sidebar__item{{ active == 'today' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/today.php"><i class="ti ti-checkbox"></i>{{ __('Hoje', 'taskplus') }}</a>
            </li>
            {% endif %}
            {% if nav.board %}
            <li class="taskplus-sidebar__item{{ active == 'board' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/board.php"><i class="ti ti-layout-kanban"></i>{{ __('Quadro', 'taskplus') }}</a>
            </li>
            {% endif %}
            {% if nav.routines %}
            <li class="taskplus-sidebar__item{{ active == 'routines' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/routines.php"><i class="ti ti-repeat"></i>{{ __('Rotinas', 'taskplus') }}</a>
            </li>
            {% endif %}
            {% if nav.week %}
            <li class="taskplus-sidebar__item{{ active == 'week' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/week.php"><i class="ti ti-calendar-week"></i>{{ __('Semana', 'taskplus') }}</a>
            </li>
            {% endif %}
            {# 6c-1: o Histórico era a última entrada desabilitada — com
               ele no ar, todas as telas do hub viraram links. #}
            {% if nav.team %}
            <li class="taskplus-sidebar__item{{ active == 'team' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/team.php"><i class="ti ti-users"></i>{{ __('Equipe', 'taskplus') }}</a>
            </li>
            {% endif %}
            {% if nav.panel %}
            <li class="taskplus-sidebar__item{{ active == 'panel' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/panel.php"><i class="ti ti-chart-bar"></i>{{ __('Painel', 'taskplus') }}</a>
            </li>
            {% endif %}
            {% if nav.history %}
            <li class="taskplus-sidebar__item{{ active == 'history' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/history.php"><i class="ti ti-history"></i>{{ __('Histórico', 'taskplus') }}</a>
            </li>
            {% endif %}
            {% if nav.config %}
            <li class="taskplus-sidebar__item{{ active == 'config' ? ' taskplus-sidebar__item--active' : '' }}">
                <a href="{{ plugin_web_dir }}/front/config.form.php"><i class="ti ti-settings"></i>{{ __('Configurações', 'taskplus') }}</a>
            </li>
            {% endif %}
            {# 8b-2: porta de volta para a Visão Geral nativa, SÓ para
               quem tem a página inicial trocada pelo direito da home. O
               marcador taskplus_home=0 abre a exceção na régua do
               redirect (Home::shouldRedirect) — vale por clique. A raiz
               do GLPI é o plugin_web_dir sem o sufixo do plugin. #}
            {% if nav.home %}
            <li class="taskplus-sidebar__item taskplus-sidebar__item--exit">
                <a href="{{ plugin_web_dir|replace({'/plugins/taskplus': ''}) }}/front/central.php?taskplus_home=0">
                    <i class="ti ti-layout-dashboard"></i>{{ __('Visão Geral', 'taskplus') }}</a>
            </li>
            {% endif %}
        </ul>
    </nav>
</div>
