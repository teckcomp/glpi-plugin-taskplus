{# Task+ — tela "Hoje" (Etapa 1: avulsas, check 1 clique, KPIs) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/taskplus.css">

<div class="taskplus-app" id="taskplus-today"
     data-csrf="{{ csrf_token }}"
     data-user-id="{{ current_user_id }}"
     data-ajax-url="{{ plugin_web_dir }}/ajax/occurrence.php">

    {# ================= COLUNA ESQUERDA: título + sidebar ================= #}
    <div class="taskplus-left">
        <div class="taskplus-pagetitle">
            <div class="taskplus-brand">
                <img class="taskplus-brand__mark" alt=""
                     src="{{ plugin_web_dir }}/img/taskplus-mark.svg">
                <h2>{{ __('Task+', 'taskplus') }}</h2>
            </div>
            <span>{{ __('Suas tarefas do dia, num lugar só', 'taskplus') }}</span>
        </div>
        <nav class="taskplus-sidebar">
            <ul>
                {% if nav.today %}
                <li class="taskplus-sidebar__item taskplus-sidebar__item--active">
                    <a href="{{ plugin_web_dir }}/front/today.php"><i class="ti ti-checkbox"></i>{{ __('Hoje', 'taskplus') }}</a>
                </li>
                {% endif %}
                {# Telas das próximas etapas: entradas desabilitadas de propósito
                   (link morto daria 404). Viram <a> quando cada etapa fechar. #}
                {% if nav.routines %}
                <li class="taskplus-sidebar__item taskplus-sidebar__item--disabled" title="{{ __('Em breve (Etapa 2)', 'taskplus') }}">
                    <span><i class="ti ti-repeat"></i>{{ __('Rotinas', 'taskplus') }}</span>
                </li>
                {% endif %}
                {% if nav.week %}
                <li class="taskplus-sidebar__item taskplus-sidebar__item--disabled" title="{{ __('Em breve (Etapa 5)', 'taskplus') }}">
                    <span><i class="ti ti-calendar-week"></i>{{ __('Semana', 'taskplus') }}</span>
                </li>
                {% endif %}
                {% if nav.team %}
                <li class="taskplus-sidebar__item taskplus-sidebar__item--disabled" title="{{ __('Em breve (Etapa 4)', 'taskplus') }}">
                    <span><i class="ti ti-users"></i>{{ __('Equipe', 'taskplus') }}</span>
                </li>
                {% endif %}
                {% if nav.panel %}
                <li class="taskplus-sidebar__item taskplus-sidebar__item--disabled" title="{{ __('Em breve (Etapa 5)', 'taskplus') }}">
                    <span><i class="ti ti-chart-bar"></i>{{ __('Painel', 'taskplus') }}</span>
                </li>
                {% endif %}
                {% if nav.history %}
                <li class="taskplus-sidebar__item taskplus-sidebar__item--disabled" title="{{ __('Em breve (Etapa 5)', 'taskplus') }}">
                    <span><i class="ti ti-history"></i>{{ __('Histórico', 'taskplus') }}</span>
                </li>
                {% endif %}
                {% if nav.config %}
                <li class="taskplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/config.form.php"><i class="ti ti-settings"></i>{{ __('Configurações', 'taskplus') }}</a>
                </li>
                {% endif %}
            </ul>
        </nav>
    </div>

    {# ================= ÁREA PRINCIPAL (Etapa 1: avulsas) ================= #}
    <div class="taskplus-main">

        {# KPIs do dia — valores preenchidos pelo JS a partir do payload #}
        <div class="taskplus-kpis">
            <div class="taskplus-kpi">
                <span class="taskplus-kpi__value" id="tp-kpi-today">0</span>
                <span class="taskplus-kpi__label">{{ __('Para hoje', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi taskplus-kpi--done">
                <span class="taskplus-kpi__value" id="tp-kpi-done">0</span>
                <span class="taskplus-kpi__label">{{ __('Concluídas', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi taskplus-kpi--late">
                <span class="taskplus-kpi__value" id="tp-kpi-late">0</span>
                <span class="taskplus-kpi__label">{{ __('Atrasadas', 'taskplus') }}</span>
            </div>
        </div>

        <div class="taskplus-toolbar">
            <button type="button" class="btn btn-primary" id="tp-btn-new">
                <i class="ti ti-plus"></i>&nbsp;{{ __('Nova tarefa', 'taskplus') }}
            </button>
            <label class="taskplus-toolbar__toggle">
                <input type="checkbox" id="tp-show-done">
                {{ __('Mostrar concluídas', 'taskplus') }}
            </label>
        </div>

        {# Lista (seções Atrasadas/Hoje) renderizada pelo JS #}
        <div id="tp-list"></div>
    </div>
</div>

{# ================= MODAL de nova/edição de avulsa ================= #}
<div class="taskplus-modal" id="tp-modal" hidden>
    <div class="taskplus-modal__box">
        <h3 id="tp-modal-title">{{ __('Nova tarefa avulsa', 'taskplus') }}</h3>
        <label class="taskplus-field">
            <span>{{ __('Título', 'taskplus') }} *</span>
            <input type="text" id="tp-f-name" maxlength="255" autocomplete="off">
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field">
                <span>{{ __('Data', 'taskplus') }}</span>
                <input type="date" id="tp-f-date">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Horário-limite', 'taskplus') }}</span>
                <input type="time" id="tp-f-time">
            </label>
        </div>
        <label class="taskplus-field">
            <span>{{ __('Categoria', 'taskplus') }}</span>
            <input type="text" id="tp-f-category" maxlength="255" autocomplete="off">
        </label>
        <label class="taskplus-field">
            <span>{{ __('Descrição', 'taskplus') }}</span>
            <textarea id="tp-f-description" rows="3"></textarea>
        </label>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-btn-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-btn-save">{{ __('Salvar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# Estado inicial da tela. O front gera este JSON com JSON_HEX_TAG & cia,
   então um "</script>" em nome de tarefa NÃO quebra a página — por isso
   (e só por isso) o |raw é seguro aqui. #}
<script type="application/json" id="taskplus-data">{{ payload_json|raw }}</script>
<script src="{{ plugin_web_dir }}/js/taskplus.js?v={{ plugin_version }}"></script>
