{# Task+ — tela "Hoje" (Etapa 1; 2 blocos na 4a; 3 colunas na 8a) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/taskplus.css">

<div class="taskplus-app" id="taskplus-today"
     data-csrf="{{ csrf_token }}"
     data-user-id="{{ current_user_id }}"
     data-ajax-url="{{ plugin_web_dir }}/ajax/occurrence.php"
     data-comments-url="{{ plugin_web_dir }}/ajax/comment.php">

    {# ================= COLUNA ESQUERDA: título + sidebar =================
       Extraída para partial na Etapa 2a (deixou de ser a única tela). #}
    {% include '@taskplus/_sidebar.html.twig' with {'active': 'today'} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="taskplus-main">

        {# KPIs do dia — ordem definida com o usuário em 05/08 (Etapa 4a):
           atrasadas primeiro (o que cobra ação), concluídas por último.
           "Pendentes" nasce em 0: a marcação chega na Etapa 4b. #}
        <div class="taskplus-kpis">
            <div class="taskplus-kpi taskplus-kpi--late">
                <span class="taskplus-kpi__value" id="tp-kpi-late">0</span>
                <span class="taskplus-kpi__label">{{ __('Atrasadas', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi">
                <span class="taskplus-kpi__value" id="tp-kpi-today">0</span>
                <span class="taskplus-kpi__label">{{ __('Para hoje', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi taskplus-kpi--pending">
                <span class="taskplus-kpi__value" id="tp-kpi-pending">0</span>
                <span class="taskplus-kpi__label">{{ __('Pendentes', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi taskplus-kpi--done">
                <span class="taskplus-kpi__value" id="tp-kpi-done">0</span>
                <span class="taskplus-kpi__label">{{ __('Concluídas', 'taskplus') }}</span>
            </div>
        </div>

        {# Três colunas IGUAIS (Etapa 8a, decisão nº 10): Chamados ·
           Tarefas do GLPI · Minhas tarefas. Empilham em tela estreita. #}
        <div class="taskplus-columns">

            <section class="taskplus-block">
                <header class="taskplus-block__head">
                    <h3 class="taskplus-block__title">{{ __('Chamados', 'taskplus') }}</h3>
                </header>
                {# Cards somente leitura, ordenados por SLA, renderizados pelo JS.
                   Clique abre a página nativa do chamado. #}
                <div id="tp-list-tickets"></div>
            </section>

            <section class="taskplus-block">
                <header class="taskplus-block__head">
                    <h3 class="taskplus-block__title">{{ __('Tarefas do Sistema', 'taskplus') }}</h3>
                    {# Filtro de origem em botões (antes era um select que
                       passava despercebido) — vale só para este bloco. #}
                    <div class="taskplus-segmented" id="tp-filter-source" role="group"
                         aria-label="{{ __('Origem', 'taskplus') }}">
                        <button type="button" class="taskplus-segmented__btn taskplus-segmented__btn--on"
                                data-source="all">{{ __('Todas', 'taskplus') }}</button>
                        <button type="button" class="taskplus-segmented__btn"
                                data-source="ticket">{{ __('Chamados', 'taskplus') }}</button>
                        <button type="button" class="taskplus-segmented__btn"
                                data-source="project">{{ __('Projetos', 'taskplus') }}</button>
                    </div>
                </header>
                {# Seções Chamados / Projetos, renderizadas pelo JS #}
                <div id="tp-list-native"></div>
            </section>

            <section class="taskplus-block">
                <header class="taskplus-block__head">
                    <h3 class="taskplus-block__title">{{ __('Minhas tarefas', 'taskplus') }}</h3>
                    <div class="taskplus-block__tools">
                        <label class="taskplus-toolbar__toggle">
                            <input type="checkbox" id="tp-show-done">
                            {{ __('Mostrar concluídas', 'taskplus') }}
                        </label>
                        <button type="button" class="btn btn-primary btn-sm" id="tp-btn-new">
                            <i class="ti ti-plus"></i>&nbsp;{{ __('Nova tarefa', 'taskplus') }}
                        </button>
                    </div>
                </header>
                {# Seções Atrasadas / rotinas / avulsas, renderizadas pelo JS #}
                <div id="tp-list-own"></div>
            </section>

        </div>
    </div>
</div>

{# ================= MODAL de nova/edição de avulsa ================= #}
<div class="taskplus-modal" id="tp-modal" hidden>
    <div class="taskplus-modal__box">
        <h3 id="tp-modal-title">{{ __('Nova tarefa avulsa', 'taskplus') }}</h3>
        <label class="taskplus-field">
            <span>{{ __('Título', 'taskplus') }} *</span>
            <input type="text" id="tp-f-name" maxlength="255" autocomplete="off">
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field">
                <span>{{ __('Data', 'taskplus') }}</span>
                <input type="date" id="tp-f-date">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Horário-limite', 'taskplus') }}</span>
                <input type="time" id="tp-f-time">
            </label>
        </div>
        <label class="taskplus-field">
            <span>{{ __('Categoria', 'taskplus') }}</span>
            <input type="text" id="tp-f-category" maxlength="255" autocomplete="off">
        </label>
        <label class="taskplus-field">
            <span>{{ __('Descrição', 'taskplus') }}</span>
            <textarea id="tp-f-description" rows="3"></textarea>
        </label>
        {# 8e-1: diálogo da tarefa — só na EDIÇÃO (tarefa nova não tem
           id). A thread é renderizada pelo JS (textContent sempre);
           quem participa = dono + criador (decisão nº 28). #}
        <div class="taskplus-dialog" id="tp-dialog" hidden>
            <h4>{{ __('Diálogo', 'taskplus') }}</h4>
            <ul class="taskplus-dialog__list" id="tp-d-list"></ul>
            <p class="taskplus-dialog__empty" id="tp-d-empty" hidden>{{ __('Nenhum comentário ainda.', 'taskplus') }}</p>
            <div class="taskplus-dialog__composer">
                <textarea id="tp-d-text" rows="2" maxlength="2000"
                          placeholder="{{ __('Escreva um comentário…', 'taskplus') }}"></textarea>
                <button type="button" class="btn btn-primary" id="tp-d-send">{{ __('Enviar', 'taskplus') }}</button>
            </div>
        </div>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-btn-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-btn-save">{{ __('Salvar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# ================= MODAL de pendência (Etapa 4b) ================= #}
<div class="taskplus-modal" id="tp-pending-modal" hidden>
    <div class="taskplus-modal__box">
        <h3>{{ __('Marcar como pendente', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-p-title"></p>
        <label class="taskplus-field">
            <span>{{ __('Motivo', 'taskplus') }} *</span>
            <textarea id="tp-p-reason" rows="2"
                      placeholder="{{ __('Ex.: aguardando peça do fornecedor', 'taskplus') }}"></textarea>
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field">
                <span>{{ __('Volta ao fluxo em', 'taskplus') }} *</span>
                <input type="date" id="tp-p-until">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Hora', 'taskplus') }} *</span>
                <input type="time" id="tp-p-time">
            </label>
        </div>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-p-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-p-save">{{ __('Salvar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# ================= MODAL de "pular hoje" (Etapa 4b) ================= #}
<div class="taskplus-modal" id="tp-skip-modal" hidden>
    <div class="taskplus-modal__box">
        <h3>{{ __('Pular hoje', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-s-title"></p>
        <p class="taskplus-modal__hint">
            {{ __('A tarefa sai do dia sem contar como concluída nem como atrasada. A rotina segue normal amanhã.', 'taskplus') }}
        </p>
        <label class="taskplus-field">
            <span>{{ __('Motivo', 'taskplus') }} *</span>
            <textarea id="tp-s-reason" rows="2"
                      placeholder="{{ __('Ex.: servidor em manutenção, não houve backup', 'taskplus') }}"></textarea>
        </label>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-s-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-s-save">{{ __('Pular hoje', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# Estado inicial da tela. O front gera este JSON com JSON_HEX_TAG & cia,
   então um "</script>" em nome de tarefa NÃO quebra a página — por isso
   (e só por isso) o |raw é seguro aqui. #}
<script type="application/json" id="taskplus-data">{{ payload_json|raw }}</script>
<script src="{{ plugin_web_dir }}/js/taskplus.js?v={{ plugin_version }}"></script>
