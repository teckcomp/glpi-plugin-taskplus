{# Task+ — tela "Painel" (Etapa 6b: indicadores pessoais) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/taskplus.css">

<div class="taskplus-app" id="taskplus-panel"
     data-csrf="{{ csrf_token }}"
     data-user-id="{{ current_user_id }}"
     data-ajax-url="{{ plugin_web_dir }}/ajax/panel.php">

    {# ================= COLUNA ESQUERDA: título + sidebar ================= #}
    {% include '@taskplus/_sidebar.html.twig' with {'active': 'panel'} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="taskplus-main">

        {# Período (de–até, padrão 5b-2 p2). Sem busca: o Painel não
           lista itens — só agrega. O aviso do recorte é do JS. #}
        <div class="taskplus-toolbar2">
            {# 6b-2 p1: "Ver painel de:" — nasce OCULTO e só aparece
               quando o payload traz opções (gestor com técnicos no
               escopo). Quem popula é o JS: as opções vêm do servidor,
               não do template. #}
            {# A-2a: a caixa deixou de ser <label> porque agora abriga DOIS
               controles (filtro + seletor) — um <label> só pode rotular um.
               A classe é a mesma, então o CSS da barra não muda. #}
            <div class="taskplus-toolbar2__label" id="tp-p-viewbox" hidden>
                <label for="tp-p-view">{{ __('Ver painel de', 'taskplus') }}</label>
                <input type="search" id="tp-p-viewfilter"
                       class="taskplus-toolbar2__vfilter"
                       placeholder="{{ __('Filtrar por nome ou setor', 'taskplus') }}"
                       aria-label="{{ __('Filtrar por nome ou setor', 'taskplus') }}">
                <select id="tp-p-view" class="taskplus-toolbar2__vselect"></select>
                <span class="taskplus-toolbar2__vcount" id="tp-p-viewcount" hidden></span>
            </div>
            <label class="taskplus-toolbar2__label">{{ __('De', 'taskplus') }}
                <input type="date" id="tp-p-from">
            </label>
            <label class="taskplus-toolbar2__label">{{ __('Até', 'taskplus') }}
                <input type="date" id="tp-p-to">
            </label>
            <button type="button" class="btn btn-primary btn-sm" id="tp-p-apply">{{ __('Aplicar', 'taskplus') }}</button>
            <button type="button" class="btn btn-ghost-secondary btn-sm" id="tp-p-clear">{{ __('Últimos 90 dias', 'taskplus') }}</button>
            <div class="taskplus-toolbar2__note" id="tp-p-note" hidden></div>
        </div>

        {# 6b-2 p1: faixa de identificação — nada de confundir os números
           de outra pessoa com os próprios. Texto e visibilidade são do JS. #}
        <div class="taskplus-viewnote" id="tp-p-viewnote" hidden>
            <i class="ti ti-eye"></i>
            <span id="tp-p-viewnote-text"></span>
        </div>

        {# Cartões do período: taxa, concluídas, devidas, pendentes,
           melhor dia — preenchidos pelo JS a partir do payload. #}
        <div class="taskplus-kpis">
            <div class="taskplus-kpi taskplus-kpi--done">
                <span class="taskplus-kpi__value" id="tp-pk-rate">—</span>
                <span class="taskplus-kpi__label">{{ __('Taxa de conclusão', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi">
                <span class="taskplus-kpi__value" id="tp-pk-done">0</span>
                <span class="taskplus-kpi__label">{{ __('Concluídas', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi">
                <span class="taskplus-kpi__value" id="tp-pk-due">0</span>
                <span class="taskplus-kpi__label">{{ __('Devidas no período', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi taskplus-kpi--pending">
                <span class="taskplus-kpi__value" id="tp-pk-pending">0</span>
                <span class="taskplus-kpi__label">{{ __('Pendentes', 'taskplus') }}</span>
            </div>
            <div class="taskplus-kpi">
                <span class="taskplus-kpi__value" id="tp-pk-best">—</span>
                <span class="taskplus-kpi__label">{{ __('Melhor dia da semana', 'taskplus') }}</span>
            </div>
        </div>

        {# Aviso fixo (decisão nº 3): as origens do GLPI são estado atual,
           sem dado por dia — ficam fora dos números do Painel. #}
        <div class="taskplus-weeknote">
            <i class="ti ti-info-circle"></i>
            <span>{{ __('O Painel mede as tarefas próprias do plugin (rotinas e avulsas). As origens do GLPI — chamados e projetos — não têm dado por dia e ficam de fora. Tarefa pendente sai da régua: tem volta marcada.', 'taskplus') }}</span>
        </div>

        {# Heatmap calendário (colunas = semanas, linhas seg–dom) #}
        <div class="taskplus-panelblock">
            <div class="taskplus-panelblock__head">
                <h3>{{ __('Conclusões por dia', 'taskplus') }}</h3>
                <div class="taskplus-hm__legend" id="tp-p-legend"></div>
            </div>
            <div class="taskplus-hm" id="tp-p-heatmap"></div>
        </div>

        {# Taxa por rotina (top 10) — some no modo equipe, onde a mesma
           rotina de vários técnicos viraria linhas homônimas. #}
        <div class="taskplus-panelblock" id="tp-p-routines-block">
            <div class="taskplus-panelblock__head">
                <h3>{{ __('Taxa por rotina', 'taskplus') }}</h3>
            </div>
            <div id="tp-p-routines"></div>
        </div>

        {# 6b-2 p2: taxa por responsável — só no modo equipe. Quem mostra
           e esconde os dois blocos é o JS, pelo `view.kind`. #}
        <div class="taskplus-panelblock" id="tp-p-owners-block" hidden>
            <div class="taskplus-panelblock__head">
                <h3>{{ __('Taxa por responsável', 'taskplus') }}</h3>
            </div>
            <div id="tp-p-owners"></div>
        </div>
    </div>
</div>

{# Estado inicial da tela. O front gera este JSON com JSON_HEX_TAG & cia,
   então um "</script>" em nome de rotina NÃO quebra a página — por isso
   (e só por isso) o |raw é seguro aqui. #}
<script type="application/json" id="taskplus-panel-data">{{ payload_json|raw }}</script>
<script src="{{ plugin_web_dir }}/js/panel.js?v={{ plugin_version }}"></script>
