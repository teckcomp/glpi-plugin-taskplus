{# Task+ — tela "Quadro" (Etapa 4d: kanban por fases) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/taskplus.css?v={{ plugin_version }}">

<div class="taskplus-app" id="taskplus-board"
     data-csrf="{{ csrf_token }}"
     data-user-id="{{ current_user_id }}"
     data-ajax-url="{{ plugin_web_dir }}/ajax/board.php">

    {# ================= COLUNA ESQUERDA: título + sidebar ================= #}
    {% include '@taskplus/_sidebar.html.twig' with {'active': 'board'} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="taskplus-main">

        <div class="taskplus-board-hint">
            <i class="ti ti-hand-move"></i>
            <span>{{ __('Arraste os cards entre as colunas. Soltar em "Concluídas" conclui; em "Pendentes" pede motivo, data e hora. "Atrasadas" é automática — a tarefa volta sozinha à fase de origem ao ganhar novo prazo.', 'taskplus') }}</span>
        </div>

        {# Colunas + cards, renderizados pelo JS a partir do payload #}
        <div class="taskplus-board" id="tp-board"></div>
    </div>
</div>

{# ================= MODAL de edição (4d-2 — regras da tela Hoje) ================= #}
<div class="taskplus-modal" id="tp-be-modal" hidden>
    <div class="taskplus-modal__box">
        <h3 id="tp-be-title">{{ __('Editar tarefa', 'taskplus') }}</h3>
        <label class="taskplus-field">
            <span>{{ __('Título', 'taskplus') }} *</span>
            <input type="text" id="tp-be-name" maxlength="255" autocomplete="off">
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field">
                <span>{{ __('Data', 'taskplus') }}</span>
                <input type="date" id="tp-be-date">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Horário-limite', 'taskplus') }}</span>
                <input type="time" id="tp-be-time">
            </label>
        </div>
        <label class="taskplus-field">
            <span>{{ __('Categoria', 'taskplus') }}</span>
            <input type="text" id="tp-be-category" maxlength="255" autocomplete="off">
        </label>
        <label class="taskplus-field">
            <span>{{ __('Descrição', 'taskplus') }}</span>
            <textarea id="tp-be-description" rows="3"></textarea>
        </label>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-be-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-be-save">{{ __('Salvar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# ================= MODAL de pendência (mesmo contrato da Etapa 4b) ================= #}
<div class="taskplus-modal" id="tp-bp-modal" hidden>
    <div class="taskplus-modal__box">
        <h3>{{ __('Marcar como pendente', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-bp-title"></p>
        <label class="taskplus-field">
            <span>{{ __('Motivo', 'taskplus') }} *</span>
            <textarea id="tp-bp-reason" rows="2"
                      placeholder="{{ __('Ex.: aguardando peça do fornecedor', 'taskplus') }}"></textarea>
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field">
                <span>{{ __('Volta ao fluxo em', 'taskplus') }} *</span>
                <input type="date" id="tp-bp-until">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Hora', 'taskplus') }} *</span>
                <input type="time" id="tp-bp-time">
            </label>
        </div>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-bp-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-bp-save">{{ __('Salvar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# Estado inicial da tela. O front gera este JSON com JSON_HEX_TAG & cia,
   então um "</script>" em nome de tarefa NÃO quebra a página — por isso
   (e só por isso) o |raw é seguro aqui. #}
<script type="application/json" id="taskplus-board-data">{{ payload_json|raw }}</script>
<script src="{{ plugin_web_dir }}/js/board.js?v={{ plugin_version }}"></script>
