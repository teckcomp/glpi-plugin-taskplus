{# Task+ — tela "Equipe" (Etapa 5a: leitura para o gestor).
   Placar por técnico + lista do dia ao expandir (variante C da abertura
   da Etapa 5). Tudo renderizado pelo JS a partir do payload embutido. #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/taskplus.css?v={{ plugin_version }}">

<div class="taskplus-app" id="taskplus-team"
     data-user-id="{{ current_user_id }}"
     data-csrf="{{ csrf_token }}"
     data-ajax-url="{{ plugin_web_dir }}/ajax/team.php"
     data-attachments-url="{{ plugin_web_dir }}/ajax/attachment.php">

    {# ================= COLUNA ESQUERDA: título + sidebar ================= #}
    {% include '@taskplus/_sidebar.html.twig' with {'active': 'team'} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="taskplus-main">

        <div class="taskplus-board-hint">
            <i class="ti ti-users"></i>
            <span>{{ __('O dia de cada técnico dos setores que você administra — os mesmos números que ele vê na tela Hoje. Clique no técnico para abrir as tarefas.', 'taskplus') }}</span>
        </div>

        {# Placar + listas, renderizados pelo JS a partir do payload #}
        <div class="taskplus-team" id="tp-team"></div>
    </div>
</div>

{# ================= MODAL de edição (5b-2: gestor edita a tarefa
   própria do Task+ do técnico — mesmas regras da tela Hoje dele) ===== #}
<div class="taskplus-modal" id="tp-t-edit-modal" hidden>
    <div class="taskplus-modal__box">
        <h3>{{ __('Editar tarefa do técnico', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-t-e-tech"></p>
        <label class="taskplus-field">
            <span>{{ __('Título', 'taskplus') }} *</span>
            <input type="text" id="tp-t-e-name" maxlength="255">
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field">
                <span>{{ __('Data', 'taskplus') }}</span>
                <input type="date" id="tp-t-e-date">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Horário-limite', 'taskplus') }}</span>
                <input type="time" id="tp-t-e-time">
            </label>
        </div>
        <label class="taskplus-field">
            <span>{{ __('Categoria', 'taskplus') }}</span>
            <input type="text" id="tp-t-e-category" maxlength="100">
        </label>
        <label class="taskplus-field">
            <span>{{ __('Descrição', 'taskplus') }}</span>
            <textarea id="tp-t-e-description" rows="2"></textarea>
        </label>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-t-e-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-t-e-save">{{ __('Salvar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# ================= MODAL de pendência (5b-2: motivo + data + hora
   obrigatórios, regra da 4b — a pendência é DO TÉCNICO) ============= #}
<div class="taskplus-modal" id="tp-t-pending-modal" hidden>
    <div class="taskplus-modal__box">
        <h3>{{ __('Marcar como pendente', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-t-p-title"></p>
        <label class="taskplus-field">
            <span>{{ __('Motivo', 'taskplus') }} *</span>
            <textarea id="tp-t-p-reason" rows="2"
                      placeholder="{{ __('Ex.: aguardando peça do fornecedor', 'taskplus') }}"></textarea>
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field">
                <span>{{ __('Volta ao fluxo em', 'taskplus') }} *</span>
                <input type="date" id="tp-t-p-until">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Hora', 'taskplus') }} *</span>
                <input type="time" id="tp-t-p-time">
            </label>
        </div>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-t-p-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-t-p-save">{{ __('Salvar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# ================= MODAL de reprovação (11b — decisão nº 61): o
   comentário do gestor é OBRIGATÓRIO e vai gravado no diálogo da
   tarefa; a tarefa volta para aberta no dia original ============== #}
<div class="taskplus-modal" id="tp-t-reject-modal" hidden>
    <div class="taskplus-modal__box">
        <h3>{{ __('Reprovar execução', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-t-r-title"></p>
        <p class="taskplus-modal__hint">{{ __('A tarefa volta para aberta no dia original e o técnico vê o seu comentário no diálogo.', 'taskplus') }}</p>
        <label class="taskplus-field">
            <span>{{ __('Motivo da reprovação', 'taskplus') }} *</span>
            <textarea id="tp-t-r-reason" rows="3" maxlength="2000"
                      placeholder="{{ __('Ex.: a evidência anexada não cobre o passo 3 do procedimento', 'taskplus') }}"></textarea>
        </label>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-t-r-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-t-r-save">{{ __('Reprovar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# ================= MODAL de diálogo (8e-2): o gestor lê a conversa da
   tarefa do técnico; ESCREVE só se for o criador (decisão nº 28) — o
   `can_write` da resposta esconde o compositor para os demais. ====== #}
<div class="taskplus-modal" id="tp-t-dialog-modal" hidden>
    <div class="taskplus-modal__box">
        <h3>{{ __('Diálogo', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-t-d-title"></p>
        <div class="taskplus-dialog">
            <ul class="taskplus-dialog__list" id="tp-t-d-list"></ul>
            <p class="taskplus-dialog__empty" id="tp-t-d-empty" hidden>{{ __('Nenhum comentário ainda.', 'taskplus') }}</p>
            <div class="taskplus-dialog__composer" id="tp-t-d-composer">
                <textarea id="tp-t-d-text" rows="2" maxlength="2000"
                          placeholder="{{ __('Escreva um comentário…', 'taskplus') }}"></textarea>
                {# 8e-3b: anexo NUMA SEGUNDA LINHA (flex-wrap) — dentro do
                   composer o leitor não vê; fora da linha do texto o
                   campo não colapsa #}
                <input type="file" id="tp-t-d-file" class="taskplus-dialog__file">
                <button type="button" class="btn btn-primary" id="tp-t-d-send">{{ __('Enviar', 'taskplus') }}</button>
            </div>
            <p class="taskplus-dialog__empty" id="tp-t-d-readonly" hidden>{{ __('Você acompanha como leitor — escrevem o dono e o criador da tarefa.', 'taskplus') }}</p>
        </div>
        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-t-d-close">{{ __('Fechar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# ================= MODAL de criação (5c-1 avulsa · 5c-2 rotina · 5c-3
   destino "todos do setor": gestor cria para o técnico OU para todos os
   membros de um setor administrado — uma cópia por membro) =========== #}
<div class="taskplus-modal" id="tp-t-create-modal" hidden>
    <div class="taskplus-modal__box taskplus-modal__box--wide">
        <h3>{{ __('Nova tarefa (Equipe)', 'taskplus') }}</h3>
        <p class="taskplus-modal__subject" id="tp-t-c-tech"></p>

        {# 5c-3: destino — o técnico expandido (padrão) ou todos de um
           setor. No setor entram o seletor (setores administrados, via
           payload) e o checkbox "incluir a mim". #}
        <div class="taskplus-field">
            <span>{{ __('Destino', 'taskplus') }}</span>
            <div class="taskplus-monthly-mode" id="tp-t-c-dest-wrap">
                <label><input type="radio" name="tp-t-c-dest" value="tech" checked>{{ __('O técnico acima', 'taskplus') }}</label>
                <label><input type="radio" name="tp-t-c-dest" value="group">{{ __('Todos de um setor', 'taskplus') }}</label>
            </div>
        </div>
        <div id="tp-t-c-group-block" hidden>
            <label class="taskplus-field">
                <span>{{ __('Setor', 'taskplus') }}</span>
                <select id="tp-t-c-group"></select>
            </label>
            <label class="taskplus-checkline">
                <input type="checkbox" id="tp-t-c-include-me">
                {{ __('Incluir a mim como destinatário', 'taskplus') }}
            </label>
        </div>

        {# 5c-2: Avulsa (um dia) ou Rotina (recorrente) #}
        <div class="taskplus-field">
            <span>{{ __('Tipo', 'taskplus') }}</span>
            <div class="taskplus-monthly-mode" id="tp-t-c-kind-wrap">
                <label><input type="radio" name="tp-t-c-kind" value="avulsa" checked>{{ __('Avulsa (um dia)', 'taskplus') }}</label>
                <label><input type="radio" name="tp-t-c-kind" value="rotina">{{ __('Rotina (recorrente)', 'taskplus') }}</label>
            </div>
        </div>

        <label class="taskplus-field">
            <span>{{ __('Título', 'taskplus') }} *</span>
            <input type="text" id="tp-t-c-name" maxlength="255">
        </label>
        <div class="taskplus-modal__row">
            <label class="taskplus-field" id="tp-t-c-date-wrap">
                <span>{{ __('Data', 'taskplus') }}</span>
                <input type="date" id="tp-t-c-date">
            </label>
            <label class="taskplus-field">
                <span>{{ __('Horário-limite', 'taskplus') }}</span>
                <input type="time" id="tp-t-c-time">
            </label>
        </div>
        <label class="taskplus-field" id="tp-t-c-cat-wrap">
            <span>{{ __('Categoria', 'taskplus') }}</span>
            <input type="text" id="tp-t-c-category" maxlength="100">
        </label>
        <label class="taskplus-field">
            <span id="tp-t-c-desc-label">{{ __('Descrição', 'taskplus') }}</span>
            <textarea id="tp-t-c-description" rows="2"></textarea>
        </label>

        {# ---- Bloco de recorrência (só no tipo Rotina) — espelho da
           tela Rotinas; a validação real é o cleanFields da Routine ---- #}
        <div id="tp-t-c-routine-block" hidden>
            <label class="taskplus-field">
                <span>{{ __('Frequência', 'taskplus') }}</span>
                <select id="tp-t-c-frequency">
                    <option value="daily">{{ __('Diária', 'taskplus') }}</option>
                    <option value="weekly">{{ __('Semanal', 'taskplus') }}</option>
                    <option value="monthly">{{ __('Mensal', 'taskplus') }}</option>
                </select>
            </label>

            <div id="tp-t-c-block-daily" class="taskplus-field">
                <label class="taskplus-checkline">
                    <input type="checkbox" id="tp-t-c-only-workdays">
                    {{ __('Só dias úteis (segunda a sexta)', 'taskplus') }}
                </label>
            </div>

            <div id="tp-t-c-block-weekly" class="taskplus-field" hidden>
                <span>{{ __('Dias da semana', 'taskplus') }}</span>
                <div class="taskplus-weekdays" id="tp-t-c-weekdays">
                    <label><input type="checkbox" value="1">{{ __('Seg', 'taskplus') }}</label>
                    <label><input type="checkbox" value="2">{{ __('Ter', 'taskplus') }}</label>
                    <label><input type="checkbox" value="3">{{ __('Qua', 'taskplus') }}</label>
                    <label><input type="checkbox" value="4">{{ __('Qui', 'taskplus') }}</label>
                    <label><input type="checkbox" value="5">{{ __('Sex', 'taskplus') }}</label>
                    <label><input type="checkbox" value="6">{{ __('Sáb', 'taskplus') }}</label>
                    <label><input type="checkbox" value="7">{{ __('Dom', 'taskplus') }}</label>
                </div>
            </div>

            <div id="tp-t-c-block-monthly" class="taskplus-field" hidden>
                <div class="taskplus-monthly-mode">
                    <label><input type="radio" name="tp-t-c-monthly-mode" value="day" checked>{{ __('Dia fixo do mês', 'taskplus') }}</label>
                    <label><input type="radio" name="tp-t-c-monthly-mode" value="pos">{{ __('Posição (ex.: última sexta)', 'taskplus') }}</label>
                </div>
                <div class="taskplus-modal__row" id="tp-t-c-monthly-day-row">
                    <label class="taskplus-field">
                        <span>{{ __('Dia do mês', 'taskplus') }}</span>
                        <input type="number" id="tp-t-c-monthday" min="1" max="31">
                    </label>
                </div>
                <div class="taskplus-modal__row" id="tp-t-c-monthly-pos-row" hidden>
                    <label class="taskplus-field">
                        <span>{{ __('Posição', 'taskplus') }}</span>
                        <select id="tp-t-c-monthweek">
                            <option value="1">{{ __('1ª', 'taskplus') }}</option>
                            <option value="2">{{ __('2ª', 'taskplus') }}</option>
                            <option value="3">{{ __('3ª', 'taskplus') }}</option>
                            <option value="4">{{ __('4ª', 'taskplus') }}</option>
                            <option value="5">{{ __('5ª', 'taskplus') }}</option>
                            <option value="-1">{{ __('Última', 'taskplus') }}</option>
                        </select>
                    </label>
                    <label class="taskplus-field">
                        <span>{{ __('Dia da semana', 'taskplus') }}</span>
                        <select id="tp-t-c-monthweekday">
                            <option value="1">{{ __('Segunda-feira', 'taskplus') }}</option>
                            <option value="2">{{ __('Terça-feira', 'taskplus') }}</option>
                            <option value="3">{{ __('Quarta-feira', 'taskplus') }}</option>
                            <option value="4">{{ __('Quinta-feira', 'taskplus') }}</option>
                            <option value="5">{{ __('Sexta-feira', 'taskplus') }}</option>
                            <option value="6">{{ __('Sábado', 'taskplus') }}</option>
                            <option value="7">{{ __('Domingo', 'taskplus') }}</option>
                        </select>
                    </label>
                </div>
            </div>

            <div class="taskplus-modal__row">
                <label class="taskplus-field">
                    <span>{{ __('Início', 'taskplus') }}</span>
                    <input type="date" id="tp-t-c-begin">
                </label>
                <label class="taskplus-field">
                    <span>{{ __('Término (opcional)', 'taskplus') }}</span>
                    <input type="date" id="tp-t-c-end">
                </label>
            </div>
        </div>

        <div class="taskplus-modal__actions">
            <button type="button" class="btn btn-ghost-secondary" id="tp-t-c-cancel">{{ __('Cancelar', 'taskplus') }}</button>
            <button type="button" class="btn btn-primary" id="tp-t-c-save">{{ __('Criar', 'taskplus') }}</button>
        </div>
    </div>
</div>

{# Estado inicial da tela. O front gera este JSON com JSON_HEX_TAG & cia,
   então um "</script>" em nome de tarefa NÃO quebra a página — por isso
   (e só por isso) o |raw é seguro aqui. #}
<script type="application/json" id="taskplus-team-data">{{ payload_json|raw }}</script>
<script src="{{ plugin_web_dir }}/js/team.js?v={{ plugin_version }}"></script>
